# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quantum_rag
POSTGRES_USER=quantum_rag
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://quantum_rag:change_me@postgres:5432/quantum_rag

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Vector store
FAISS_INDEX_PATH=/app/data/faiss_index/knowledge_base.index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Quantum re-ranker
QUANTUM_BACKEND=aer_simulator
QUANTUM_SHOTS=1024

# Streamlit
STREAMLIT_API_BASE_URL=http://api:8000
